# Secrets and credentials must be supplied by AWS Secrets Manager or ECS task secrets.
AWS_REGION=us-east-1
MEDIA_S3_BUCKET=replace-with-private-bucket
FRONTEND_ORIGINS=https://app.example.com
INTERNAL_SERVICE_KEY=replace-with-long-random-secret
TURNSTILE_SECRET=
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=no-reply@example.com
VERIFICATION_URL=https://app.example.com/verify-email
COOKIE_SECURE=true

IDENTITY_DB_URL=jdbc:postgresql://identity-db-host:5432/identity_db
IDENTITY_DB_USER=rankkings
IDENTITY_DB_PASSWORD=replace-with-secret
CATALOG_DB_URL=jdbc:postgresql://catalog-db-host:5432/catalog_db
CATALOG_DB_USER=rankkings
CATALOG_DB_PASSWORD=replace-with-secret
SOCIAL_DB_URL=jdbc:postgresql://social-db-host:5432/social_db
SOCIAL_DB_USER=rankkings
SOCIAL_DB_PASSWORD=replace-with-secret
